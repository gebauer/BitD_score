<div class="bsg">
  <div class="bsg-status">
    {{#if beamerUser}}
    <span class="{{#if beamerOnline}}on{{else}}off{{/if}}"><i class="fa-solid fa-display"></i> Beamer: {{beamerUser}} {{#if beamerOnline}}(verbunden){{else}}(offline){{/if}}</span>
    {{else}}
    <span class="off"><i class="fa-solid fa-display"></i> Kein Beamer-Benutzer eingestellt (Moduleinstellungen)</span>
    {{/if}}
    <span>Modus: <b>{{#if isWizard}}Wizard{{else}}{{#if isScore}}Score{{else}}Karte{{/if}}{{/if}}</b></span>
  </div>

  {{#unless isWizard}}{{#unless isScore}}{{#unless isDebrief}}
  <section class="bsg-start">
    <button type="button" class="bsg-big" data-action="start"><i class="fa-solid fa-play"></i> Neuen Score planen</button>
    {{#if hasDraft}}<button type="button" data-action="resume"><i class="fa-solid fa-rotate-right"></i> Planung fortsetzen</button>{{/if}}
    {{#if running.length}}
    <h3>Laufende Scores</h3>
    <ul class="bsg-list">
      {{#each running}}<li><span>{{name}}</span><span><button type="button" data-action="show" data-entry="{{id}}"><i class="fa-solid fa-display"></i> Am Beamer zeigen</button>
        <button type="button" data-action="debrief" data-entry="{{id}}"><i class="fa-solid fa-flag-checkered"></i> Score beenden</button></span></li>{{/each}}
    </ul>
    {{/if}}
    {{#if finished.length}}
    <h3>Abgeschlossene Scores</h3>
    <ul class="bsg-list">
      {{#each finished}}<li><span>{{name}}</span><span><button type="button" data-action="show" data-entry="{{id}}"><i class="fa-solid fa-display"></i> Am Beamer zeigen</button>
        <button type="button" data-action="debrief" data-entry="{{id}}"><i class="fa-solid fa-pen"></i> Debrief bearbeiten</button></span></li>{{/each}}
    </ul>
    {{/if}}
    <h3>Vorbereitete Scores</h3>
    <ul class="bsg-list">
      {{#each allPreps}}<li><span>{{#if used}}✓ {{/if}}{{name}}</span><button type="button" data-action="editPrep" data-prep="{{id}}"><i class="fa-solid fa-pen"></i> Bearbeiten</button></li>
      {{else}}<li><span class="bsg-tip">Noch keine Vorbereitungen.</span></li>{{/each}}
    </ul>
    <div class="bsg-choices">
      <button type="button" data-action="newPrep"><i class="fa-solid fa-feather"></i> Neuen Score vorbereiten</button>
      <button type="button" data-action="importPrep"><i class="fa-solid fa-file-import"></i> Importieren (JSON)</button>
    </div>
  </section>
  {{/unless}}{{/unless}}{{/unless}}

  {{#if isWizard}}
  <nav class="bsg-steps">
    {{#each steps}}
    <button type="button" class="{{#if active}}active{{/if}}{{#if done}} done{{/if}}" data-action="goto" data-step="{{index}}">{{n}} {{label}}</button>
    {{/each}}
  </nav>

  <div class="bsg-hint">
    <div class="bsg-hint-head"><b>{{step.title}}</b> <span class="bsg-rule">{{{ruleHTML}}}</span></div>
    <p>{{step.hint}}</p>
  </div>

  <div class="bsg-prep">
    {{#if prep}}
    <div class="bsg-hint-head"><span><i class="fa-solid fa-feather"></i> {{prep.name}}</span>
      <span><button type="button" data-action="editPrep" data-prep="{{prep.id}}" data-tooltip="Vorbereitung bearbeiten"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="unlinkPrep" data-tooltip="Verknüpfung lösen"><i class="fa-solid fa-link-slash"></i></button></span></div>
    {{#if is_art}}{{#if prep.hook}}<p><b>Aufhänger:</b> {{prep.hook}}</p>{{/if}}{{#if prep.loot}}<p><b>Beute:</b> {{prep.loot}}</p>{{/if}}{{/if}}
    {{#if is_ziel}}
    {{#each prep.npcs}}<p><b>{{roleLabel}}:</b> {{name}}{{#if public}} <i>(öffentlich)</i>{{/if}}</p>{{/each}}
    {{#if prep.loot}}<p><b>Beute:</b> {{prep.loot}}</p>{{/if}}
    {{/if}}
    {{#if is_plan}}{{#if prep.otherPlans}}<p>Notizen vorhanden für: {{prep.otherPlans}}</p>{{/if}}{{#if prep.planNote}}<p><b>{{prep.planLabel}}:</b> {{prep.planNote}}</p>{{/if}}{{/if}}
    {{#if is_detail}}{{#if prep.planNote}}<p><b>{{prep.planLabel}}:</b> {{prep.planNote}}</p>{{else}}<p class="bsg-tip">Für diesen Plan nichts vorbereitet – improvisieren.</p>{{/if}}{{/if}}
    {{#if is_loadout}}{{#if prep.planNote}}<p><b>{{prep.planLabel}}:</b> {{prep.planNote}}</p>{{/if}}{{/if}}
    {{#if is_engagement}}
    {{#if prep.strengths}}<p><b>Stark gegen:</b> {{prep.strengths}}</p>{{/if}}
    {{#if prep.weaknesses}}<p><b>Schwach gegen:</b> {{prep.weaknesses}}</p>{{/if}}
    <p class="bsg-tip">{{prep.obstacleCount}} Hindernis(se) vorbereitet · {{prep.clockCount}} Uhr(en){{#if prep.hiddenClocks}}, davon {{prep.hiddenClocks}} verdeckt{{/if}} – werden beim Start angelegt.</p>
    {{/if}}
    {{else}}
    <label><i class="fa-solid fa-feather"></i> Vorbereitung
      <select name="prepLink"><option value="">– keine (improvisiert) –</option>{{#each preps}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
    {{/if}}
  </div>

  <div class="bsg-body">
    {{#if is_art}}
    <div class="bsg-choices">
      {{#each kinds}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="set" data-path="draft.kind" data-value="{{id}}" data-toggle="1" data-tooltip="{{desc}}">{{label}}</button>{{/each}}
    </div>
    <div class="bsg-choices">
      {{#each sources}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="set" data-path="draft.source" data-value="{{id}}" data-toggle="1">{{label}}</button>{{/each}}
    </div>
    <label>Name <input type="text" data-field="draft.name" value="{{draft.name}}" autocomplete="off"></label>
    {{/if}}

    {{#if is_ziel}}
    <label>Ziel <input type="text" data-field="draft.target" value="{{draft.target}}" autocomplete="off"></label>
    <div class="bsg-choices"><span>Tier</span>
      {{#each tiers}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="set" data-path="draft.tier" data-value="{{value}}">{{label}}</button>{{/each}}
    </div>
    <p class="bsg-tip">Beschreibt das Ziel so, dass seine Stärken sichtbar werden – daraus malt ihr später die Startposition.</p>
    {{/if}}

    {{#if is_plan}}
    <div class="bsg-choices wrap">
      {{#each plans}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="set" data-path="draft.plan" data-value="{{id}}" data-toggle="1" data-tooltip="{{desc}} Detail: {{detail}}">{{label}}</button>{{/each}}
    </div>
    {{/if}}

    {{#if is_detail}}
    {{#if plan}}
    <label>{{plan.detail}} <input type="text" data-field="draft.detail" value="{{draft.detail}}" placeholder="{{plan.placeholder}}" autocomplete="off"></label>
    <p class="bsg-tip">Unbekannt? Gather Information {{{gatherHTML}}} – Planung bleibt gespeichert.</p>
    {{else}}<p class="bsg-tip">Noch kein Plan gewählt.</p>{{/if}}
    {{/if}}

    {{#if is_loadout}}
    <table class="bsg-loads">
      {{#each crew}}
      <tr><th>{{#if cardImg}}<img class="bsg-crewimg" src="{{cardImg}}" alt="">{{/if}}{{name}}{{#if dock}} <small>({{dock}})</small>{{/if}}</th>{{#each loads}}<td><button type="button" class="{{#if selected}}selected{{/if}}" data-op="load" data-actor="{{../id}}" data-value="{{id}}">{{label}} ({{value}})</button></td>{{/each}}</tr>
      {{else}}<tr><td>Keine Spielercharaktere mit Besitzer gefunden.</td></tr>{{/each}}
    </table>
    <div class="bsg-choices">
      <button type="button" data-action="rereadCrew" data-tooltip="Crew-Karten erneut auslesen, z. B. wenn eine Karte umgedreht wurde. Gewählte Loads bleiben."><i class="fa-solid fa-arrows-rotate"></i> Crew neu einlesen</button>
    </div>
    <p class="bsg-tip">Gegenstände erst im Spiel ankreuzen {{{loadRuleHTML}}}.</p>
    {{/if}}

    {{#if is_engagement}}
    <div class="bsg-factors">
      {{#each factors}}
      <button type="button" class="plus{{#if plusOn}} on{{/if}}" data-op="factor" data-key="{{plusKey}}">+1W {{plus}}</button>
      <button type="button" class="minus{{#if minusOn}} on{{/if}}" data-op="factor" data-key="{{minusKey}}">−1W {{minus}}</button>
      {{/each}}
    </div>
    <div class="bsg-rollrow">
      <span class="bsg-pool">Pool: <b>{{poolLabel}}</b> <small>{{poolRule}}</small></span>
      {{#if roll}}
      <span class="bsg-result">{{#each roll.dice}}<b class="{{#if hit}}hit{{/if}}">{{v}}</b>{{/each}} → <b class="red">{{roll.position.label}}</b></span>
      <button type="button" data-action="reroll" data-tooltip="Ergebnis verwerfen"><i class="fa-solid fa-xmark"></i></button>
      {{else}}
      <button type="button" class="bsg-big" data-action="roll"><i class="fa-solid fa-dice"></i> Würfeln</button>
      {{/if}}
    </div>
    {{#unless roll}}
    <div class="bsg-choices bsg-manual">
      <span>Echte Würfel – {{#if poolZero}}niedrigster{{else}}höchster{{/if}} Würfel:</span>
      <button type="button" data-action="manualRoll" data-value="1">1</button>
      <button type="button" data-action="manualRoll" data-value="2">2</button>
      <button type="button" data-action="manualRoll" data-value="3">3</button>
      <button type="button" data-action="manualRoll" data-value="4">4</button>
      <button type="button" data-action="manualRoll" data-value="5">5</button>
      <button type="button" data-action="manualRoll" data-value="6">6</button>
      <button type="button" data-action="manualRoll" data-value="66" {{#if poolZero}}disabled{{/if}} data-tooltip="Kritisch: zwei Sechsen">6 6</button>
    </div>
    {{/unless}}
    <div class="bsg-choices">
      <button type="button" data-action="obstacles"><i class="fa-solid fa-cards-blank"></i> Hindernisse ziehen (nur SL)</button>
    </div>
    <p class="bsg-tip">Nicht den Anmarsch beschreiben – direkt zum ersten ernsten Hindernis schneiden.</p>
    {{/if}}
  </div>

  <footer class="bsg-nav">
    <button type="button" data-action="prev" {{#if isFirst}}disabled{{/if}}><i class="fa-solid fa-arrow-left"></i> Zurück</button>
    <button type="button" data-action="release" data-tooltip="Beamer zeigt wieder die Karte; die Planung bleibt erhalten"><i class="fa-solid fa-map"></i> Pause</button>
    <button type="button" data-action="reset"><i class="fa-solid fa-trash"></i> Verwerfen</button>
    {{#if isLast}}
    <button type="button" class="bsg-big" data-action="begin" {{#unless roll}}disabled{{/unless}}><i class="fa-solid fa-flag-checkered"></i> Score beginnen</button>
    {{else}}
    <button type="button" class="bsg-big" data-action="next">Weiter: {{nextLabel}} <i class="fa-solid fa-arrow-right"></i></button>
    {{/if}}
  </footer>
  {{/if}}

  {{#if isScore}}
  {{#with scoreView}}
  <div class="bsg-hint">
    <div class="bsg-hint-head"><b>№ {{no}} · {{name}}</b></div>
    <p>{{target}} · {{plan}} ({{detail}}) · Start: <b class="red">{{position}}</b></p>
  </div>
  {{/with}}
  <section class="bsg-clocks">
    <h3>Uhren <small>Klick: +1 · Rechtsklick: −1</small></h3>
    {{#each rawClocks}}
    <div class="bsg-clock">
      <button type="button" class="bsg-clockface" data-action="clockTick" data-clock="{{id}}" aria-label="{{name}} weiterdrehen">
        <span class="bss-clock{{#if threat}} threat{{/if}}" style="{{style}}"></span>
      </button>
      <span class="bsg-clockname{{#if hidden}} hidden{{/if}}">{{name}} <b>{{label}}</b>{{#if hidden}} <i>(verdeckt)</i>{{/if}}</span>
      <button type="button" data-action="clockHidden" data-clock="{{id}}" data-tooltip="{{#if hidden}}Aufdecken (Beamer zeigt sie){{else}}Verdecken{{/if}}"><i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i></button>
      <button type="button" data-action="clockThreat" data-clock="{{id}}" data-tooltip="Bedrohung / Fortschritt umschalten"><i class="fa-solid {{#if threat}}fa-skull{{else}}fa-person-running{{/if}}"></i></button>
      <button type="button" data-action="clockRemove" data-clock="{{id}}" data-tooltip="Uhr löschen"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{else}}<p class="bsg-tip">Noch keine Uhren.</p>{{/each}}
    <div class="bss-clockform">
      <input type="text" name="clockName" placeholder="Name der Uhr" autocomplete="off">
      <select name="clockSize">{{#each clockSizes}}<option value="{{this}}">{{this}}</option>{{/each}}</select>
      <label><input type="checkbox" name="clockThreat" checked> Bedrohung</label>
      <button type="button" data-action="clockAdd"><i class="fa-solid fa-plus"></i> Uhr</button>
    </div>
  </section>
  <footer class="bsg-nav">
    <button type="button" data-action="openJournal"><i class="fa-solid fa-book-open"></i> Journal</button>
    <button type="button" data-action="release"><i class="fa-solid fa-map"></i> Beamer: Karte</button>
    <button type="button" data-action="debrief"><i class="fa-solid {{#if scoreDone}}fa-pen{{else}}fa-flag-checkered{{/if}}"></i> {{#if hasDebriefDraft}}Debrief fortsetzen{{else}}{{#if scoreDone}}Debrief bearbeiten{{else}}Score beenden{{/if}}{{/if}}</button>
    <button type="button" class="bsg-big" data-action="start"><i class="fa-solid fa-play"></i> Nächsten Score planen</button>
  </footer>
  {{/if}}

  {{#if isDebrief}}
  <nav class="bsg-steps">
    {{#each dsteps}}
    <button type="button" class="{{#if active}}active{{/if}}{{#if done}} done{{/if}}" data-action="dGoto" data-step="{{index}}">{{n}} {{label}}</button>
    {{/each}}
  </nav>

  <div class="bsg-hint">
    <div class="bsg-hint-head"><b>Debrief № {{dmeta.no}} · {{dmeta.name}}{{#if dmeta.rerun}} <small>(bearbeiten)</small>{{/if}}</b> <span class="bsg-rule">{{{ruleHTML}}} {{{dExtraHTML}}}</span></div>
    <p><b>{{dstep.title}}:</b> {{dstep.hint}}</p>
  </div>

  <div class="bsg-body">
    {{#if dstep_ergebnis}}
    <div class="bsg-choices">
      {{#each outcomes}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="dset" data-path="debrief.outcome" data-value="{{id}}" data-toggle="1" data-tooltip="{{desc}}">{{label}}</button>{{/each}}
    </div>
    {{#if failed}}<p class="bsg-tip">Fehlschlag: Payoff meist 0 – Heat und Verstrickungen gibt es trotzdem.</p>{{/if}}
    <label class="stack">Was ist passiert? <small>(öffentlich, 2–5 Sätze – Spieler können am Beamer mitschreiben)</small></label>
    <textarea class="bsg-text" rows="4" data-field="debrief.summary">{{debrief.summary}}</textarea>
    {{#if dmeta.clocks.length}}
    <div class="bsg-dclocks">{{#each dmeta.clocks}}<span><span class="bss-clock{{#if threat}} threat{{/if}}" style="{{style}}"></span> {{name}} {{value}}/{{size}}</span>{{/each}}</div>
    {{/if}}
    {{/if}}

    {{#if dstep_payoff}}
    <div class="bsg-grid2">
      <label>Tier Crew <input type="number" min="0" max="6" data-field="debrief.crewTier" value="{{debrief.crewTier}}"></label>
      <label>Tier Ziel <input type="number" min="0" max="6" data-field="debrief.targetTier" value="{{debrief.targetTier}}"></label>
    </div>
    <div class="bsg-choices">
      <button type="button" class="{{#if debrief.quiet}}on{{/if}}" data-op="dtoggle" data-path="debrief.quiet">Niemand weiß, dass es die Crew war (0 Rep)</button>
    </div>
    <label>Rep <input type="number" min="0" data-field="debrief.rep" value="{{debrief.rep}}" placeholder="{{calc.repSuggest}}">
      <small>Vorschlag: {{#if debrief.quiet}}0 (leise){{else}}max(0, 2 + {{calc.targetTier}} − {{calc.crewTier}}) = {{calc.repSuggest}}{{/if}}</small></label>
    <div class="bsg-choices wrap">
      {{#each coinSizes}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="dset" data-path="debrief.coin" data-value="{{value}}" data-tooltip="{{desc}}">{{coinLabel}}</button>{{/each}}
    </div>
    <label>Coin <input type="number" min="0" data-field="debrief.coin" value="{{debrief.coin}}"></label>
    <div class="bsg-grid2">
      <label>Tribut an <input type="text" data-field="debrief.tithe.boss" value="{{debrief.tithe.boss}}" placeholder="Boss (leer = kein Tribut)" autocomplete="off"></label>
      <div class="bsg-choices">
        <button type="button" class="{{#if debrief.tithe.paid}}on{{/if}}" data-op="dtoggle" data-path="debrief.tithe.paid">{{#if debrief.tithe.paid}}gezahlt{{else}}nicht gezahlt{{/if}}</button>
        {{#if debrief.tithe.paid}}<input type="number" min="0" data-field="debrief.tithe.amount" value="{{debrief.tithe.amount}}" placeholder="{{calc.titheSuggest}}" data-tooltip="Vorschlag: Crew-Tier + 1">{{/if}}
      </div>
    </div>
    {{#if debrief.tithe.boss}}{{#unless debrief.tithe.paid}}<p class="bsg-tip">Nicht gezahlt: Geduld-Uhr für {{debrief.tithe.boss}} anlegen oder weiterdrehen (wird nur notiert).</p>{{/unless}}{{/if}}
    <p class="bsg-sum">Coin {{calc.coin}} − Tribut {{calc.tithe}} = <b>{{calc.coinToCrew}}</b> für die Crew · Rep <b>{{calc.rep}}</b></p>
    {{/if}}

    {{#if dstep_heat}}
    <div class="bsg-choices">
      {{#each exposures}}<button type="button" class="{{#if selected}}selected{{/if}}" data-op="dset" data-path="debrief.exposure" data-value="{{value}}" data-tooltip="{{desc}}">{{value}} · {{label}}</button>{{/each}}
    </div>
    <div class="bsg-choices wrap">
      {{#each heatMods}}<button type="button" class="{{#if on}}on{{/if}}" data-op="dtoggle" data-path="debrief.heatMods.{{id}}">+{{value}} {{label}}</button>{{/each}}
    </div>
    {{#each heatExtraRows}}
    <div class="bsg-status-row">
      <input type="text" data-field="debrief.heatExtra.{{i}}.label" value="{{label}}" placeholder="z. B. Granate!" autocomplete="off">
      <button type="button" class="{{#if one}}on{{/if}}" data-op="dset" data-path="debrief.heatExtra.{{i}}.value" data-value="1">+1</button>
      <button type="button" class="{{#if two}}on{{/if}}" data-op="dset" data-path="debrief.heatExtra.{{i}}.value" data-value="2">+2</button>
      <button type="button" data-action="dRemoveHeat" data-index="{{i}}" data-tooltip="Zuschlag löschen"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    <div class="bsg-choices"><button type="button" data-action="dAddHeat"><i class="fa-solid fa-plus"></i> Eigener Zuschlag (+1 / +2)</button></div>
    <label>Heat <input type="number" min="0" data-field="debrief.heat" value="{{debrief.heat}}" placeholder="{{calc.heatSuggest}}"><small>Vorschlag: {{calc.heatSuggest}}</small></label>
    <div class="bsg-grid2">
      <label>Heat vorher <input type="number" min="0" max="9" data-field="debrief.heatBefore" value="{{debrief.heatBefore}}" placeholder="?"></label>
      <label>Wanted vorher <input type="number" min="0" max="4" data-field="debrief.wantedBefore" value="{{debrief.wantedBefore}}" placeholder="?"></label>
    </div>
    <p class="bsg-sum">Heat <b>+{{calc.heat}}</b>{{#if calc.hasHeatAfter}} → danach <b>{{calc.heatAfter}}</b>{{/if}}{{#if calc.overflow}} · <b class="red">+1 Wanted Level, Überlauf zählt weiter (S. 148)</b>{{/if}}</p>
    {{#if dmeta.crewActor}}<p class="bsg-tip">Vorbelegt aus dem Crew-Bogen „{{dmeta.crewActor}}“.</p>{{/if}}
    <div class="bsg-choices">
      <button type="button" data-action="dApplyHeat" {{#unless dmeta.crewActorId}}disabled{{/unless}} data-tooltip="Schreibt Heat (nach Überlauf) und Wanted auf den Crew-Bogen – mit Rückfrage. Erneut klicken ersetzt, addiert nicht."><i class="fa-solid fa-file-pen"></i> Heat auf Crew-Bogen{{#if dmeta.crewActor}} „{{dmeta.crewActor}}“{{/if}} übertragen</button>
      {{#if sheetApplied}}<span class="bsg-tip">✓ übertragen: Heat {{sheetApplied.heat}}, Wanted {{sheetApplied.wanted}}</span>{{/if}}
    </div>
    {{/if}}

    {{#if dstep_verstrickung}}
    <p class="bsg-sum">Spalte <b>{{calc.column}}</b> · {{#if calc.entZero}}Wanted 0: 2 Würfel, der niedrigste zählt{{else}}{{calc.entDice}} Würfel (Wanted {{calc.wantedAfter}}), der höchste zählt{{/if}}{{#unless calc.entKnown}} <i>(Wanted unbekannt – im Heat-Schritt eintragen)</i>{{/unless}}</p>
    <div class="bsg-rollrow">
      <button type="button" class="{{#if entSecret}}on{{/if}}" data-op="dtoggle" data-path="debrief.entanglement.secret" data-tooltip="Geheim: Wurf nur an die SL, nichts am Beamer, nicht auf der Überblick-Seite">{{#if entSecret}}<i class="fa-solid fa-eye-slash"></i> geheim{{else}}<i class="fa-solid fa-eye"></i> öffentlich{{/if}}</button>
      {{#if entDice.length}}
      <span class="bsg-result">{{#each entDice}}<b class="{{#if hit}}hit{{/if}}">{{v}}</b>{{/each}} → <b class="red">{{entValue}}</b></span>
      <button type="button" data-action="dRollClear" data-tooltip="Wurf verwerfen"><i class="fa-solid fa-xmark"></i></button>
      {{else}}
      <button type="button" class="bsg-big" data-action="dRoll"><i class="fa-solid fa-dice"></i> Würfeln</button>
      {{/if}}
    </div>
    {{#unless entDice.length}}
    <div class="bsg-choices bsg-manual">
      <span>Echte Würfel – {{#if calc.entZero}}niedrigster{{else}}höchster{{/if}} Würfel:</span>
      <button type="button" data-action="dEntManual" data-value="1">1</button>
      <button type="button" data-action="dEntManual" data-value="2">2</button>
      <button type="button" data-action="dEntManual" data-value="3">3</button>
      <button type="button" data-action="dEntManual" data-value="4">4</button>
      <button type="button" data-action="dEntManual" data-value="5">5</button>
      <button type="button" data-action="dEntManual" data-value="6">6</button>
    </div>
    {{/unless}}
    <table class="bsg-ent">
      <caption>{{calc.column}} <small>– Eintrag anklicken übernimmt den Namen</small></caption>
      {{#each entTable}}
      <tr class="{{#if hit}}hit{{/if}}"><th>{{range}}</th><td>{{#each options}}<button type="button" class="{{#if chosen}}selected{{/if}}" data-op="dset" data-path="debrief.entanglement.name" data-value="{{name}}" data-tooltip="{{desc}}"><b>{{name}}</b> <small>{{desc}}</small></button>{{/each}}</td></tr>
      {{/each}}
    </table>
    <label>Verstrickung <input type="text" data-field="debrief.entanglement.name" value="{{debrief.entanglement.name}}" placeholder="Name aus der Tabelle" autocomplete="off"></label>
    <textarea class="bsg-text" rows="3" data-field="debrief.entanglement.text" placeholder="Was passiert konkret?">{{debrief.entanglement.text}}</textarea>
    {{/if}}

    {{#if dstep_fraktionen}}
    {{#each statusRows}}
    <div class="bsg-status-row">
      <input type="text" data-field="debrief.status.{{i}}.faction" value="{{faction}}" placeholder="Fraktion" autocomplete="off">
      <select data-field="debrief.status.{{i}}.delta">{{#each deltaOpts}}<option value="{{v}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <input type="text" data-field="debrief.status.{{i}}.note" value="{{note}}" placeholder="Notiz" autocomplete="off">
      <button type="button" data-action="dRemoveFaction" data-index="{{i}}" data-tooltip="Zeile löschen"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{else}}<p class="bsg-tip">Noch keine Status-Änderungen.</p>{{/each}}
    <div class="bsg-choices wrap">
      <button type="button" data-action="dAddFaction"><i class="fa-solid fa-plus"></i> Fraktion</button>
      {{#each factionSuggest}}<button type="button" data-action="dAddFaction" data-name="{{name}}" data-tooltip="Vorschlag ({{hint}})"><i class="fa-solid fa-plus"></i> {{name}} <small>({{hint}})</small></button>{{/each}}
    </div>
    {{/if}}

    {{#if dstep_xp}}
    <table class="bsg-xp">
      <thead><tr><th></th>{{#each pcs.[0].attrs}}<th>{{label}}</th>{{/each}}<th>Playbook</th><th>Überzeug.</th><th>Laster</th><th>Σ</th></tr></thead>
      <tbody>
      {{#each pcs}}
      <tr>
        <th>{{#if cardImg}}<img class="bsg-crewimg" src="{{cardImg}}" alt="">{{/if}}{{name}}</th>
        {{#each attrs}}<td class="bsg-counter"><button type="button" data-op="xp" data-actor="{{../id}}" data-key="{{id}}" data-value="-1">−</button><b>{{value}}</b><button type="button" data-op="xp" data-actor="{{../id}}" data-key="{{id}}" data-value="1">+</button></td>{{/each}}
        {{#each triggers}}<td class="bsg-tri" data-tooltip="{{label}}">{{#each opts}}{{#if v}}<button type="button" class="{{#if on}}on{{/if}}" data-op="xp" data-actor="{{../../id}}" data-key="{{../id}}" data-value="{{v}}">{{v}}</button>{{/if}}{{/each}}</td>{{/each}}
        <td><b>{{total}}</b></td>
      </tr>
      {{else}}<tr><td>Keine Crew im Score gespeichert.</td></tr>{{/each}}
      </tbody>
    </table>
    {{#each pcs}}{{#if trigger}}<p class="bsg-tip"><b>{{name}}:</b> {{trigger}}</p>{{/if}}{{/each}}
    <h3 class="bsg-sub">Crew-XP <small>Σ {{crewXpTotal}}</small></h3>
    {{#each crewXp}}
    <div class="bsg-xprow"><span>{{label}}</span><span class="bsg-tri">{{#each opts}}{{#if v}}<button type="button" class="{{#if on}}on{{/if}}" data-op="crewxp" data-key="{{../id}}" data-value="{{v}}">{{v}}</button>{{/if}}{{/each}}</span></div>
    {{/each}}
    <p class="bsg-tip">Spieler können ihre XP am Beamer anklicken. Nochmal klicken = eins weniger.</p>
    {{/if}}

    {{#if dstep_abschluss}}
    <ul class="bsg-summary">
      <li><b>Ergebnis:</b> {{#if outcome}}{{outcome.label}}{{else}}<i>nicht gewählt</i>{{/if}}</li>
      <li><b>Payoff:</b> Coin {{calc.coin}}{{#if calc.titheOn}} − Tribut {{calc.tithe}} ({{debrief.tithe.boss}}){{/if}} = {{calc.coinToCrew}} · Rep {{calc.rep}}</li>
      <li><b>Heat:</b> {{calc.heat}}{{#if heatModsText}} ({{heatModsText}}){{/if}}{{#if calc.hasHeatAfter}} → {{calc.heatAfter}}{{/if}}{{#if calc.overflow}} · +1 Wanted{{/if}}</li>
      <li><b>Verstrickung{{#if entSecret}} (geheim){{/if}}:</b> {{#if debrief.entanglement.name}}{{debrief.entanglement.name}}{{else}}–{{/if}}{{#if entValue}} · Wurf {{entValue}}{{/if}}</li>
      <li><b>Fraktionen:</b> {{#each statusPublic}}{{faction}} {{deltaLabel}}{{#unless @last}}, {{/unless}}{{else}}–{{/each}}</li>
      <li><b>XP:</b> {{#each pcs}}{{name}} {{total}}{{#unless @last}} · {{/unless}}{{/each}} · Crew {{crewXpTotal}}</li>
    </ul>
    <div class="bsg-choices">
      <button type="button" data-action="dApplyHeat" {{#unless dmeta.crewActorId}}disabled{{/unless}} data-tooltip="Schreibt Heat (nach Überlauf) und Wanted auf den Crew-Bogen – mit Rückfrage. Erneut klicken ersetzt, addiert nicht."><i class="fa-solid fa-file-pen"></i> Heat auf Crew-Bogen{{#if dmeta.crewActor}} „{{dmeta.crewActor}}“{{/if}} übertragen</button>
      {{#if sheetApplied}}<span class="bsg-tip">✓ übertragen: Heat {{sheetApplied.heat}}, Wanted {{sheetApplied.wanted}}</span>{{/if}}
    </div>
    <label class="stack">SL-Notizen <small>(geheim – nur auf der 🔒 SL-Seite: Nachspiel, Pläne der Fraktionen, offene Fäden)</small></label>
    <textarea class="bsg-text" rows="4" data-field="debrief.gmNotes">{{debrief.gmNotes}}</textarea>
    <p class="bsg-tip">Coin, Rep, Status und XP bitte von Hand auf die Bögen übertragen – nur Heat/Wanted kann der Knopf oben eintragen.</p>
    {{/if}}
  </div>

  <footer class="bsg-nav">
    <button type="button" data-action="dPrev" {{#if dIsFirst}}disabled{{/if}}><i class="fa-solid fa-arrow-left"></i> Zurück</button>
    <button type="button" data-action="dPause" data-tooltip="Zurück zur Score-Ansicht; der Debrief bleibt erhalten"><i class="fa-solid fa-pause"></i> Pause</button>
    <button type="button" data-action="dDiscard"><i class="fa-solid fa-trash"></i> Verwerfen</button>
    {{#if dIsLast}}
    <button type="button" class="bsg-big" data-action="dFinish"><i class="fa-solid fa-flag-checkered"></i> Score abschließen</button>
    {{else}}
    <button type="button" class="bsg-big" data-action="dNext">Weiter: {{dNextLabel}} <i class="fa-solid fa-arrow-right"></i></button>
    {{/if}}
  </footer>
  {{/if}}
</div>
